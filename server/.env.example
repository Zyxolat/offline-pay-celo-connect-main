PORT=3001
NODE_ENV=production

DATABASE_URL=postgresql://username:password@your-remote-host:5432/offlinepay

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=1h
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_real_bcrypt_hash_for_your_admin_password
ADMIN_ALLOWED_IPS=203.0.113.10

WEBAUTHN_RP_NAME=OfflinePay
WEBAUTHN_RP_ID=offline-pay-celo.vercel.app
WEBAUTHN_ORIGIN=https://offline-pay-celo.vercel.app
FRONTEND_URL=https://offline-pay-celo.vercel.app
CELO_NETWORK=mainnet

# REQUIRED in production — dedicated Celo RPC endpoint.
# The public forno.celo.org fallback is rate-limited and unreliable for
# production indexing. Use a provider such as Infura, Ankr, or dRPC.
# Example: https://celo-mainnet.infura.io/v3/<YOUR_INFURA_KEY>
CELO_RPC_URL=https://forno.celo.org

CELO_CHAIN_ID=42220
CELO_CUSD_ADDRESS=0x765DE816845861e75A25fCA122bb6bAA3c1E852a

# REQUIRED in production — private key of the withdrawal signer wallet.
# This key signs on-chain withdrawal transactions. Keep it secret and never
# commit it to source control. Generate a dedicated wallet for this purpose.
CELO_WITHDRAW_PRIVATE_KEY=

LOG_LEVEL=info
