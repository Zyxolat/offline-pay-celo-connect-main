PRIVATE_KEY=0xyour_deployer_private_key

# Celo RPC — use a dedicated node for production reliability.
# Free providers: Infura (infura.io), Ankr (ankr.com), dRPC (drpc.org)
# Example: https://celo-mainnet.infura.io/v3/<YOUR_INFURA_KEY>
CELO_RPC_URL=https://forno.celo.org

CELO_CHAIN_ID=42220
VITE_TIMELOCK_CONTRACT_ADDRESS=0x72D90d16A798095b6fC29eCf71867A87729acC31

# WalletConnect / Reown Project ID — required for wallet connections.
# 1. Create a project at https://cloud.reown.com
# 2. Add your domain (offline-pay-celo.vercel.app) under Project → Domains
# 3. Copy the Project ID here
VITE_WALLETCONNECT_PROJECT_ID=your_reown_project_id

VITE_API_URL=https://your-railway-app.up.railway.app/api
VITE_APP_URL=https://offline-pay-celo.vercel.app
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_CELO_CUSD_ADDRESS=0x765DE816845861e75A25fCA122bb6bAA3c1E852a
